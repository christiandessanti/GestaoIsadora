# Copie este arquivo para .env e preencha os valores.
# O .env NÃO vai para o Git.

# Servidor
PORT=3000
# Endereço em que o servidor escuta. 0.0.0.0 = aceita acesso de outros aparelhos da rede
# (útil para testar no celular). No VPS com Nginx, use 127.0.0.1.
HOST=0.0.0.0
NODE_ENV=development

# Segredo usado para assinar o cookie de sessão.
# Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=isadora_erp
DB_USER=isadora_app
DB_PASSWORD=

# Usuário TI (criado automaticamente pelo "npm run db:setup", apenas se ainda não existir)
TI_NOME=TI
TI_LOGIN=ti
TI_SENHA=

# Senha especial inicial (usada para liberar exclusões).
# Depois pode ser alterada pela página de Configurações.
SENHA_ESPECIAL=

# Somente no VPS, se houver Nginx/Apache na frente do Node (proxy reverso): TRUST_PROXY=1
TRUST_PROXY=

# Testes automáticos (npm test). Banco SEPARADO, que é apagado a cada execução.
# Precisa terminar em "_teste". Veja a seção "Testes" do README.
DB_NAME_TESTE=isadora_erp_teste
# Caminho do Google Chrome para os testes de interface (npm run test:ui)
CHROME_PATH=/usr/bin/google-chrome
